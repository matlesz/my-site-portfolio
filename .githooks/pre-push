#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/master" ]; then
        cat >&2 <<EOF
Push blocked: direct pushes to the master branch are disabled.

Push a feature branch instead and open a pull request:
  git push origin HEAD:refs/heads/<feature-branch>
EOF
        exit 1
    fi
done
